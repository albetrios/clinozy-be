{
  "project": {
    "name": "clinozy-be",
    "displayName": "Clinozy Backend",
    "brandName": "Clinozy",
    "previousNames": ["core-be", "core-fe", "clinovia-be", "clinovia-fe"],
    "previousOwners": ["nikunjmavani"],
    "packageName": "clinozy-be"
  },
  "git": {
    "protectedBranches": ["main"],
    "defaultBranch": "main"
  },
  "environments": [
    {
      "name": "development",
      "label": "Development",
      "nodeEnvironment": "development",
      "protected": true,
      "isDefault": true
    },
    {
      "name": "production",
      "label": "Production",
      "nodeEnvironment": "production",
      "protected": true
    }
  ],
  "scopedEnvironments": [
    {
      "name": "production-restore-drill",
      "source": "production",
      "keys": ["MONTHLY_DATABASE_RESTORE_DRILL_NEON_API_KEY"],
      "purpose": "The restore drills run unattended: the Neon API key alone, without the production deploy approval or its other secrets"
    }
  ],
  "providers": {
    "github": {
      "enabled": true,
      "repository": "albetrios/clinozy-be",
      "owners": ["nikunjmavani"]
    }
  }
}
