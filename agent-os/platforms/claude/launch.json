{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:worker"],
      "port": 9090
    },
    {
      "name": "dashboards-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tooling/dev/dashboards/proxy.mjs"],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "db-viewer",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tooling/db-viewer/cli.mjs", "--no-open"],
      "port": 4984
    }
  ]
}
