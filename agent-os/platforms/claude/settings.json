{
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_search",
      "mcp__be-codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__be-codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__be-codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__be-codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__be-codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__be-codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status",
      "mcp__be-codegraph__codegraph_status",
      "Bash(pnpm validate*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm routes*)",
      "Bash(pnpm docs*)",
      "Bash(pnpm tsdoc*)",
      "Bash(pnpm agent-os*)",
      "Bash(pnpm guard*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh pr*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__be-codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_files",
      "mcp__be-codegraph__codegraph_files",
      "Bash(pnpm iteration*)",
      "Bash(pnpm db*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(gh run *)",
      "mcp__headroom__*",
      "mcp__be-headroom__*",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__actions_get",
      "mcp__github__actions_list"
    ],
    "ask": [
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-prompt-skill-router.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-guard-edits.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-guardrails.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-no-unrequested-pr.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-edit-hooks.mjs\"",
            "if": "Edit(**)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-edit-hooks.mjs\"",
            "if": "Write(**)"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-large-read-nudge.sh\""
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-injection-scan.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-subagent-verify.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-push-ci-watch.mjs\"",
            "if": "Bash(git push*)",
            "asyncRewake": true,
            "timeout": 2700
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-gate-failure-hint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-edit-hooks.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-turn-end-tests.mjs\"",
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-pre-compact-preserve.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/be-session-end.sh\""
          }
        ]
      }
    ]
  }
}
