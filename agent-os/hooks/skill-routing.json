{
  "description": "GENERATED by `pnpm agent-os:generate` from agent-os/skills/chains.json and each skill's `trigger` / `triggerNote` frontmatter — the rows of agent-os/docs/skill-triggers.md. Do not edit.",
  "routes": [
    {
      "chain": "route-change",
      "globs": [
        "src/domains/**/*.routes.ts"
      ],
      "skills": [
        "be-api-contract-guard",
        "be-route-schema-doc-guard",
        "be-route-catalog",
        "be-seed-maintainer"
      ],
      "optional": [
        "be-openapi-multilingual"
      ],
      "note": "Adding or changing an API route end-to-end."
    },
    {
      "chain": "schema-change",
      "globs": [
        "src/domains/**/*.schema.ts"
      ],
      "skills": [
        "be-schema-generator",
        "be-sql-design-guard",
        "be-db-migration-maintainer",
        "be-rls-tenant-isolation-guard"
      ],
      "note": "Adding or changing a Drizzle schema / table end-to-end."
    },
    {
      "chain": "worker-change",
      "globs": [
        "src/domains/**/events/**",
        "src/domains/**/queues/**",
        "src/domains/**/workers/**"
      ],
      "skills": [
        "be-workers-events",
        "be-test-generator",
        "be-tsdoc-export-guard"
      ],
      "note": "Adding or changing events, queues, or workers."
    },
    {
      "chain": "new-domain",
      "globs": [
        "src/domains/**/*.container.ts"
      ],
      "skills": [
        "be-domain-generator",
        "be-schema-generator",
        "be-db-migration-maintainer",
        "be-workers-events",
        "be-route-schema-doc-guard",
        "be-route-catalog",
        "be-seed-maintainer",
        "be-test-generator",
        "be-tsdoc-export-guard",
        "be-overview-doc-maintainer",
        "be-system-narrative-maintainer"
      ],
      "note": "Scaffolding a whole new domain or sub-domain (the full DAG)."
    },
    {
      "chain": "iteration",
      "globs": [
        "iterations/*/intake-files/**"
      ],
      "skills": [
        "be-iteration-planning",
        "be-kickoff-iteration"
      ],
      "note": "A design iteration: plan the drop in intake-files/ into KICKOFF.md + plans/ (no code), then implement the ROUTE one row at a time with AS-BUILT.md."
    },
    {
      "globs": [
        ".husky/pre-commit",
        "src/scripts/tooling/run-pre-commit-guard.ts"
      ],
      "skills": [
        "be-before-commit-guard"
      ],
      "note": "The guard steps changed — or a commit failed: read the ✗ FAILED at step N/M line"
    },
    {
      "globs": [
        ".vscode/extensions.json",
        ".vscode/settings.json"
      ],
      "skills": [
        "be-ide-productivity-guard"
      ],
      "note": "Backend-relevant IDE tooling"
    },
    {
      "globs": [
        "CLAUDE.md",
        "AGENTS.md",
        "agent-os/rules/**",
        "agent-os/skills/**",
        "agent-os/agents/**",
        "agent-os/mcp/**",
        ".mcp.example.json",
        ".mcp.default.json",
        "src/tests/load/k6/**"
      ],
      "skills": [
        "be-structure-maintainer"
      ],
      "note": "Structure/naming; MCP template mirrors must stay identical (mcp-config test)"
    },
    {
      "globs": [
        "biome.json",
        ".biomeignore",
        ".husky/pre-commit",
        ".husky/pre-push",
        "src/scripts/tooling/run-ci-local-guard.ts",
        "tooling/ci/run-named-step.sh",
        ".gitleaks.toml",
        ".semgrepignore"
      ],
      "skills": [
        "be-code-quality-guard"
      ],
      "note": "Lint/format/pre-commit/pre-push + branch-name policy"
    },
    {
      "globs": [
        "docs/**/*.md",
        ".github/rulesets/*.json"
      ],
      "skills": [
        "be-docs-maintainer"
      ],
      "note": "Hand-written docs — index + cross-links"
    },
    {
      "globs": [
        "docs/deployment/runbooks/production-go-live.md"
      ],
      "skills": [
        "be-path-to-production-gate"
      ],
      "note": "Or the user asks for path to production / ready for production — a plan the user approves before any production action"
    },
    {
      "globs": [
        "iterations/*/AS-BUILT.md"
      ],
      "skills": [
        "be-kickoff-iteration"
      ],
      "note": "Iteration implementation — one ROUTE row at a time; every row's technical decisions go into AS-BUILT.md"
    },
    {
      "globs": [
        "iterations/*/plans/**"
      ],
      "skills": [
        "be-iteration-planning"
      ],
      "note": "Iteration plans — requirements and decisions, plus the route review in routes-final.md (Step 5); KICKOFF.md is written at Step 6"
    },
    {
      "globs": [
        "migrations/*.sql"
      ],
      "skills": [
        "be-db-migration-maintainer"
      ],
      "note": "Migration files (schema changes go via the schema-change chain)"
    },
    {
      "globs": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tooling/setup/agent/tool-versions.sh"
      ],
      "skills": [
        "be-dependency-security"
      ],
      "note": "Zero-vuln dependency updates + agent tool pin bumps"
    },
    {
      "globs": [
        "src/**/*.overview.md"
      ],
      "skills": [
        "be-overview-doc-maintainer"
      ],
      "note": "Per-folder overview docs"
    },
    {
      "globs": [
        "src/**/*.ts"
      ],
      "skills": [
        "be-change-completeness-guard"
      ],
      "note": "Finishing any code change — own tests + cross-cutting suites + docs + rules + skills move with it"
    },
    {
      "globs": [
        "src/**/*.ts"
      ],
      "skills": [
        "be-tsdoc-export-guard"
      ],
      "note": "Public export added/renamed — TSDoc summary (+ @remarks on service/worker/policy); also a new policy constant, or a tsdoc:check budget regression"
    },
    {
      "globs": [
        "src/OVERVIEW.md",
        "src/PATTERNS.md",
        "src/FLOWS.md",
        "src/POLICIES.md"
      ],
      "skills": [
        "be-system-narrative-maintainer"
      ],
      "note": "System-level narratives"
    },
    {
      "globs": [
        "src/domains/**/*.cache.ts",
        "src/infrastructure/cache/redis-tombstone-cache.util.ts"
      ],
      "skills": [
        "be-read-cache-guard"
      ],
      "note": "Redis read caches — key scope, tombstone invalidation, fail-open, TTL, tests"
    },
    {
      "globs": [
        "src/domains/**/*.validator.ts",
        "src/domains/**/*.serializer.ts",
        "src/shared/utils/**",
        "src/domains/**/__tests__/**",
        "src/tests/unit/**"
      ],
      "skills": [
        "be-test-generator"
      ],
      "note": "Pure-layer units + domain e2e per the testing pyramid"
    },
    {
      "globs": [
        "src/domains/**/seed/**",
        "src/scripts/seed/**"
      ],
      "skills": [
        "be-seed-maintainer"
      ],
      "note": "Keep per-domain seeds aligned with schemas + routes"
    },
    {
      "globs": [
        "src/infrastructure/**",
        "src/shared/middlewares/**",
        "src/shared/config/**"
      ],
      "skills": [
        "be-production-hardening-guard"
      ],
      "note": "Middleware, infra or security config"
    },
    {
      "globs": [
        "src/infrastructure/database/contexts/**",
        "src/domains/**/*.worker.ts"
      ],
      "skills": [
        "be-rls-tenant-isolation-guard"
      ],
      "note": "DB context wrappers, workers, and RLS migrations — tenant isolation"
    },
    {
      "globs": [
        "src/infrastructure/queue/bootstrap.ts",
        "src/infrastructure/queue/scheduler.ts",
        "src/infrastructure/queue/worker-runtime/**"
      ],
      "skills": [
        "be-workers-events"
      ],
      "note": "Queue wiring outside a domain — register the worker in worker-registration.registry.ts (family, usesPostgres, resolvePostgresConcurrency)"
    },
    {
      "globs": [
        "src/routes.ts"
      ],
      "skills": [
        "be-domain-generator"
      ],
      "note": "Check DI wiring / route registration (new domain scaffolds via the new-domain chain)"
    },
    {
      "globs": [
        "src/shared/config/env-schema.ts",
        ".env.example"
      ],
      "skills": [
        "be-env-schema-add"
      ],
      "note": "Env var add/rename/remove"
    },
    {
      "globs": [
        "src/shared/locales/**/*.json",
        "src/shared/errors/**",
        "src/shared/middlewares/core/error-handler.middleware.ts",
        "src/domains/**/*.validator.ts",
        "src/domains/**/*.service.ts",
        "src/domains/**/*.controller.ts",
        "src/shared/constants/**"
      ],
      "skills": [
        "be-i18n-message-guard"
      ],
      "note": "User-facing copy / translation keys"
    },
    {
      "globs": [
        "src/shared/locales/*/openapi.json"
      ],
      "skills": [
        "be-openapi-multilingual"
      ],
      "note": "Multilingual OpenAPI copy"
    },
    {
      "globs": [
        "src/shared/middlewares/core/health.middleware.ts",
        "src/infrastructure/mcp/mcp-server.ts"
      ],
      "skills": [
        "be-route-schema-doc-guard"
      ],
      "note": "Route registrations outside *.routes.ts — schema summary / description / tags"
    },
    {
      "globs": [
        "src/shared/middlewares/core/idempotency.middleware.ts",
        "src/infrastructure/payment/stripe.client.ts"
      ],
      "skills": [
        "be-idempotency-guard"
      ],
      "note": "Idempotency engine + idempotencyRequired writes + Stripe mutations"
    },
    {
      "globs": [
        "src/shared/utils/http/list-query.util.ts"
      ],
      "skills": [
        "be-api-contract-guard"
      ],
      "note": "List endpoints (search/sort/pagination); also route params / public ids / statuses / headers. Status policy: docs/reference/api/response-codes.md"
    },
    {
      "globs": [
        "src/tests/chaos/**"
      ],
      "skills": [
        "be-chaos-test-maintainer"
      ],
      "note": "Toxiproxy fault-injection suite"
    },
    {
      "globs": [
        "src/tests/contract/**"
      ],
      "skills": [
        "be-contract-test-maintainer"
      ],
      "note": "Outbound HTTP contracts (Stripe/Resend/S3)"
    }
  ]
}
